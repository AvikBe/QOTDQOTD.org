{
  "name": "qotdqotd",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema:local": "wrangler d1 execute qotd --local --file=schema.sql",
    "db:schema:remote": "wrangler d1 execute qotd --remote --file=schema.sql",
    "db:migrate": "python3 scripts/data_to_sql.py > migration.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
